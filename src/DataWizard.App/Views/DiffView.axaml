<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DataWizard.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="DataWizard.App.Views.DiffView"
             x:DataType="vm:DiffViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- ══ Inputs ══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Spacing="10">

            <!-- The two tables -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto">

                    <Grid ColumnDefinitions="90,*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Reference"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ReferencePath}"
                                 PlaceholderText="CSV or XLSX file" />
                        <Button Grid.Column="2" Content="Browse..."
                                Command="{Binding BrowseReferenceCommand}" />
                        <ComboBox Grid.Column="3" MinWidth="140"
                                  ItemsSource="{Binding ReferenceSheets}"
                                  SelectedItem="{Binding ReferenceSheet}"
                                  IsVisible="{Binding HasReferenceSheets}"
                                  ToolTip.Tip="Worksheet of the reference workbook" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0"
                          ColumnDefinitions="90,*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Candidate"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CandidatePath}"
                                 PlaceholderText="CSV or XLSX file" />
                        <Button Grid.Column="2" Content="Browse..."
                                Command="{Binding BrowseCandidateCommand}" />
                        <ComboBox Grid.Column="3" MinWidth="140"
                                  ItemsSource="{Binding CandidateSheets}"
                                  SelectedItem="{Binding CandidateSheet}"
                                  IsVisible="{Binding HasCandidateSheets}"
                                  ToolTip.Tip="Worksheet of the candidate workbook" />
                    </Grid>
                </Grid>
            </Border>

            <!-- The comparison options -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,Auto">

                    <Grid ColumnDefinitions="Auto,180,Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Match rows by"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding MatchModes}"
                                  SelectedItem="{Binding MatchMode}"
                                  ToolTip.Tip="Positional compares row 1 with row 1; keyed compares rows that share the key columns." />
                        <TextBlock Grid.Column="2" Text="Key columns"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsKeyed}" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding KeyColumns}"
                                 PlaceholderText="id, article_no - comma or semicolon separated"
                                 IsVisible="{Binding IsKeyed}"
                                 ToolTip.Tip="Column names when both tables have a header, otherwise one-based positions." />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0"
                          ColumnDefinitions="Auto,110,Auto,110,Auto,110" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Number tolerance"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding AbsoluteTolerance}"
                                 PlaceholderText="absolute, e.g. 0.01"
                                 ToolTip.Tip="Two numbers are equal when they differ by at most this amount." />
                        <TextBlock Grid.Column="2" Text="of"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding RelativeTolerance}"
                                 PlaceholderText="relative, e.g. 0.001"
                                 ToolTip.Tip="Two numbers are equal when they differ by at most this fraction of the larger one." />
                        <TextBlock Grid.Column="4" Text="Date tolerance (min)"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="5"
                                 Text="{Binding DateToleranceMinutes}"
                                 PlaceholderText="0"
                                 ToolTip.Tip="Two dates are equal when they differ by at most this many minutes." />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0"
                          ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" Content="Ignore case"
                                  IsChecked="{Binding IgnoreCase}"
                                  VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Content="Trim values"
                                  IsChecked="{Binding TrimValues}"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0" />
                        <TextBlock Grid.Column="3" Text="Ignore columns"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="4"
                                 Text="{Binding IgnoredColumns}"
                                 PlaceholderText="updatedAt, note - left empty compares everything"
                                 ToolTip.Tip="Columns excluded from the comparison; they also do not count as structural differences." />
                    </Grid>
                </Grid>
            </Border>

            <!-- Profile and actions -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBox Text="{Binding ProfileName}"
                             PlaceholderText="Profile name (optional)" />
                    <TextBlock Classes="hint"
                               Text="{Binding ProfileDisplay}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Save profile..."
                            Command="{Binding SaveProfileCommand}" />
                    <Button Content="Load profile..."
                            Command="{Binding LoadProfileCommand}" />
                    <Button Content="Export report..."
                            Command="{Binding ExportReportCommand}" />
                    <Button Content="Compare" Classes="primary"
                            Command="{Binding CompareCommand}" />
                </StackPanel>
            </Grid>

            <!-- Result headline -->
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding SummaryText}" Classes="h2"
                           IsVisible="{Binding HasReport}" />
                <TextBlock Text="{Binding StatusText}" Classes="hint" />
                <TextBlock Text="{Binding ErrorText}" Classes="error"
                           IsVisible="{Binding HasError}" />
            </StackPanel>
        </StackPanel>

        <!-- ══ Differences ═════════════════════════════════════════════════ -->
        <DataGrid Grid.Row="1" Margin="0,10,0,10"
                  ItemsSource="{Binding Entries}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
                <DataGridTextColumn Header="Reference row" Binding="{Binding ReferenceRow}" Width="Auto" />
                <DataGridTextColumn Header="Candidate row" Binding="{Binding CandidateRow}" Width="Auto" />
                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="Auto" />
                <DataGridTextColumn Header="Reference value" Binding="{Binding ReferenceValue}" Width="*" />
                <DataGridTextColumn Header="Candidate value" Binding="{Binding CandidateValue}" Width="*" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="1.2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Classes="hint"
                   Text="Showing the first 5,000 differences; export the report for the complete list."
                   IsVisible="{Binding IsTruncated}" />
    </Grid>
</UserControl>
