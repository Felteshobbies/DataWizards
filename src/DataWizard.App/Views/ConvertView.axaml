<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DataWizard.App.ViewModels"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="DataWizard.App.Views.ConvertView"
             x:DataType="vm:ConvertViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <!-- The vertical rail that opens and closes the analysis panel. -->
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="{DynamicResource DwSurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DwBorder}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Width" Value="34" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DwAccentMuted}" />
        </Style>

        <!-- Drag handle between the workspace and the analysis panel. -->
        <Style Selector="Thumb.splitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border Width="1" HorizontalAlignment="Center"
                                Background="{DynamicResource DwBorder}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.splitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource DwAccentMuted}" />
        </Style>

        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto,Auto,Auto">

        <!-- ══ Workspace ═════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16">

            <!-- Drop zone -->
            <Border Grid.Row="0"
                    Name="DropZone"
                    Height="110"
                    CornerRadius="8"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,0,12"
                    PointerReleased="OnDropZoneClicked">
                <Border.Styles>
                    <Style Selector="Border#DropZone">
                        <Setter Property="Background" Value="{DynamicResource DwDropZone}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DwBorderStrong}" />
                    </Style>
                </Border.Styles>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                    <TextBlock Text="Drop files or folders here" Classes="h2"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="or click to browse" Classes="hint"
                               HorizontalAlignment="Center" />
                    <TextBlock Text=".csv  .txt  .log  .tsv  .dat  .xlsx  .xlsm"
                               Classes="hint mono" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Queue -->
            <Border Grid.Row="1" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12,8"
                            BorderBrush="{DynamicResource DwBorder}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding FileCountText}" Classes="h2" />
                            <Button Grid.Column="1" Content="Clear" Padding="10,3"
                                    Command="{Binding ClearCommand}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Files}"
                             SelectedItem="{Binding SelectedFile}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileRow">
                                <Grid ColumnDefinitions="28,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StateGlyph}"
                                               Classes="mono"
                                               Classes.success="{Binding IsDone}"
                                               Classes.error="{Binding IsFailed}"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="hint" Text="{Binding DirectionText}" />
                                        <TextBlock Classes="hint"
                                                   Text="{Binding Detail}"
                                                   IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                               Classes="hint" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── Compact analysis strip ────────────────────────────────
                 The gist of the analysis without opening anything. The dot
                 appears only when the detection was ambiguous. -->
            <Border Grid.Row="2" Classes="sunken" Margin="0,12,0,0" Padding="10,7">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource DwWarning}"
                             IsVisible="{Binding AnalysisNeedsAttention}"
                             ToolTip.Tip="{Binding AnalysisHeadline}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding AnalysisSummary}"
                               Classes="hint mono"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding AnalysisSummary}" />

                    <Button Grid.Column="2" Padding="10,2"
                            Content="Details"
                            Command="{Binding ToggleAnalysisCommand}"
                            IsVisible="{Binding !IsAnalysisExpanded}" />
                </Grid>
            </Border>

            <!-- Output folder -->
            <Border Grid.Row="3" Classes="card" Margin="0,12,0,0" Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="Output folder" Classes="h2" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding OutputFolder}"
                                 PlaceholderText="(same folder as the source file)" />
                        <Button Grid.Column="1" Content="Browse" Margin="6,0,0,0"
                                Command="{Binding BrowseOutputFolderCommand}" />
                        <Button Grid.Column="2" Content="Clear" Margin="6,0,0,0"
                                Command="{Binding ClearOutputFolderCommand}" />
                    </Grid>
                    <CheckBox Content="Overwrite existing files"
                              IsChecked="{Binding Overwrite}"
                              ToolTip.Tip="When off, a numeric suffix is added instead of replacing a file." />
                </StackPanel>
            </Border>

            <ProgressBar Grid.Row="4" Height="6" Margin="0,12,0,0"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}" />

            <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <Button Grid.Column="0" Classes="primary"
                        Content="Convert"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ConvertCommand}" />
                <Button Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Padding="18,10"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </Grid>

        <!-- ══ Drag handle ═══════════════════════════════════════════════ -->
        <primitives:Thumb Grid.Column="1"
                          Classes="splitter"
                          Name="AnalysisSplitter"
                          IsVisible="{Binding IsAnalysisExpanded}"
                          DragDelta="OnSplitterDrag" />

        <!-- ══ Analysis panel ════════════════════════════════════════════ -->
        <Border Grid.Column="2"
                Width="{Binding AnalysisPanelWidth}"
                IsVisible="{Binding IsAnalysisExpanded}"
                Background="{DynamicResource DwSurface}">

            <Grid RowDefinitions="Auto,*" Margin="14,16,14,16">

                <!-- Header and attention banner -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="Analysis" Classes="h1" />
                            <TextBlock Classes="hint"
                                       Text="How the selected file was read, and why." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Hide" Padding="10,3"
                                VerticalAlignment="Top"
                                Command="{Binding ToggleAnalysisCommand}" />
                    </Grid>

                    <!-- Shown only when something is genuinely ambiguous. -->
                    <Border Classes="card"
                            Padding="12"
                            BorderBrush="{DynamicResource DwWarning}"
                            IsVisible="{Binding AnalysisNeedsAttention}">
                        <StackPanel Spacing="5" DataContext="{Binding Preview}"
                                    x:DataType="vm:AnalysisPreview">
                            <TextBlock Text="Worth checking" Classes="h2 warning" />
                            <ItemsControl ItemsSource="{Binding AttentionReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="hint"
                                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="10">

                        <TextBlock Classes="hint"
                                   Text="{Binding PreviewError}"
                                   IsVisible="{Binding PreviewError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="10" DataContext="{Binding Preview}"
                                    IsVisible="{Binding, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    x:DataType="vm:AnalysisPreview">

                            <!-- Always visible: the verdict -->
                            <Border Classes="card" Padding="12">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Encoding" Classes="hint" Margin="0,0,12,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Encoding}" Margin="0,0,0,4" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Separator" Classes="hint" Margin="0,0,12,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Separator}" Margin="0,0,0,4" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Header" Classes="hint" Margin="0,0,12,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Header}" Margin="0,0,0,4" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Structure" Classes="hint" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Structure}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!-- Always visible: what each column became -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="Columns" Classes="h2" />
                                <DataGrid ItemsSource="{Binding Columns}"
                                          IsReadOnly="True"
                                          MaxHeight="300"
                                          AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding EffectiveType}" Width="Auto" />
                                        <DataGridTextColumn Header="Sample" Binding="{Binding Sample}" Width="1.2*" />
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.4*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- On demand: the evidence -->
                            <Expander Header="Why this header decision?" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="5" Margin="0,6,0,0">
                                    <TextBlock Classes="hint"
                                               Text="Each signal is scored separately and combined with the weights on the Detection tab." />
                                    <DataGrid ItemsSource="{Binding HeaderSignals}"
                                              IsReadOnly="True"
                                              MaxHeight="190"
                                              AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="Auto" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="Auto" />
                                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="Auto" />
                                            <DataGridTextColumn Header="Reasoning" Binding="{Binding Detail}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="How the separator was chosen" HorizontalAlignment="Stretch">
                                <DataGrid ItemsSource="{Binding SeparatorCandidates}"
                                          IsReadOnly="True"
                                          MaxHeight="180"
                                          Margin="0,6,0,0"
                                          AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Separator" Binding="{Binding Separator}" Width="*" />
                                        <DataGridTextColumn Header="Columns" Binding="{Binding Fields}" Width="Auto" />
                                        <DataGridTextColumn Header="Consistency" Binding="{Binding Consistency}" Width="Auto" />
                                        <DataGridCheckBoxColumn Header="Used" Binding="{Binding IsChosen}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>

                            <Expander Header="First rows as parsed" HorizontalAlignment="Stretch">
                                <Border Classes="sunken" Margin="0,6,0,0">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="240">
                                        <SelectableTextBlock Text="{Binding SampleText}" Classes="mono" />
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ Edge rail ═════════════════════════════════════════════════ -->
        <Button Grid.Column="3" Classes="rail"
                Command="{Binding ToggleAnalysisCommand}"
                ToolTip.Tip="Show or hide the analysis panel">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="{Binding AnalysisToggleLabel}"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource DwTextMuted}" />

                <Ellipse Width="7" Height="7" HorizontalAlignment="Center"
                         Fill="{DynamicResource DwWarning}"
                         IsVisible="{Binding AnalysisNeedsAttention}" />

                <LayoutTransformControl>
                    <LayoutTransformControl.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </LayoutTransformControl.LayoutTransform>
                    <TextBlock Text="ANALYSIS"
                               FontSize="10"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource DwTextMuted}" />
                </LayoutTransformControl>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
